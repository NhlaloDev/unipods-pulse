# --- Required -------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
# Protects uploads, deletes and the ingest API (the WhatsApp bridge uses it too).
ADMIN_TOKEN=change-me

# --- Branding ---------------------------------------------------------------
BOT_NAME=Pulse
GROUP_NAME=METI UniPods AI Innovation Programme, Cohort 1
TIMEZONE_LABEL=SAST

# --- Claude -----------------------------------------------------------------
CLAUDE_MODEL=claude-opus-5
# low | medium | high  (lower = faster and cheaper answers)
CLAUDE_EFFORT=medium
# 1 = if Claude declines a request, the API retries it on a fallback model automatically
CLAUDE_FALLBACKS=1

# --- Knowledge base ---------------------------------------------------------
# Below this size (characters) the whole knowledge base is sent to Claude (cached); above it, search is used.
FULL_CONTEXT_CHARS=200000
# How to read ambiguous WhatsApp dates like 03/04/2026: dmy (South Africa, UK...) or mdy (US)
DEFAULT_DATE_ORDER=dmy

# --- Optional connectors -----------------------------------------------------
# Telegram: create a bot with @BotFather, paste the token, add it to your group.
TELEGRAM_BOT_TOKEN=
# WhatsApp official API via Twilio: set the sandbox/number webhook to https://<your-host>/webhooks/twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# WhatsApp group bridge (bridge/): where Pulse runs, and which groups to watch (comma-separated, empty = all)
PULSE_URL=http://localhost:8000
WATCH_GROUPS=
# Audio/video transcription model for faster-whisper (tiny, base, small, medium, large-v3)
WHISPER_MODEL=small
